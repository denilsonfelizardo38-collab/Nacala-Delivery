      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Figtree:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n\n:root{\n  --red:#F2151C;\n  --red-press:#C10D13;\n  --red-soft:rgba(242,21,28,.14);\n  --s1:#141414;\n  --s2:#1F1F1F;\n  --s3:#2B2B2B;\n  --sidebar:#0B0B0B;\n  --ink:#FFFFFF;\n  --muted:#B9B9B9;\n  --muted2:#858585;\n  --success:#2BD46F;\n  --success-soft:#0D2417;\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{\n  background:#000;color:var(--ink);\n  font-family:'Figtree',system-ui,sans-serif;\n  -webkit-font-smoothing:antialiased;\n}\n.shell{display:flex;min-height:100vh;align-items:stretch;}\n\n/* ---------- sidebar ---------- */\n.sidebar{\n  flex:0 0 240px;width:240px;\n  background:var(--sidebar);\n  border-right:1px solid rgba(255,255,255,.055);\n  padding:24px 16px 22px;\n  display:flex;flex-direction:column;gap:0;\n}\n.brand{display:flex;align-items:center;gap:11px;padding:0 8px 22px;}\n.logo{\n  width:32px;height:32px;flex:0 0 32px;border-radius:9px;\n  background:linear-gradient(160deg,#FF3B41,var(--red-press));\n  display:flex;align-items:center;justify-content:center;\n  color:#fff;font-size:16px;\n  box-shadow:0 2px 10px rgba(242,21,28,.35);\n}\n.brand-name{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:18.5px;letter-spacing:-.02em;}\n.nav{display:flex;flex-direction:column;gap:4px;}\n.nav-item{\n  height:46px;border-radius:12px;display:flex;align-items:center;gap:12px;\n  padding:0 14px;color:var(--muted);font-size:14.5px;font-weight:600;\n}\n.nav-item i{font-size:16.5px;line-height:1;}\n.nav-item.active{background:var(--red);color:#fff;font-weight:700;box-shadow:0 6px 18px rgba(242,21,28,.25);}\n.help-label{\n  font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;\n  color:#6B6B6B;padding:0 14px;margin:26px 0 10px;\n}\n.sidebar-foot{margin-top:auto;display:flex;flex-direction:column;gap:10px;padding-top:26px;}\n.btn{\n  height:46px;border-radius:999px;display:flex;align-items:center;justify-content:center;\n  font-size:14.5px;font-weight:700;font-family:inherit;\n}\n.btn-primary{background:var(--red);color:#fff;}\n.btn-ghost{border:1px solid var(--s3);color:#fff;background:transparent;}\n\n/* ---------- main ---------- */\n.main{flex:1 1 auto;padding:22px 40px 44px;display:flex;justify-content:center;}\n.canvas{width:100%;max-width:900px;}\n.topbar{display:flex;align-items:center;justify-content:space-between;}\n.topbar-brand{display:flex;align-items:center;gap:9px;}\n.topbar-brand .logo{width:26px;height:26px;flex:0 0 26px;border-radius:7px;font-size:13px;box-shadow:none;}\n.topbar-brand span{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:16px;letter-spacing:-.01em;}\n.top-cta{\n  height:36px;padding:0 20px;border-radius:999px;border:1px solid var(--s3);\n  display:flex;align-items:center;font-size:13.5px;font-weight:700;color:#fff;\n}\n\n.segmented{\n  margin-top:18px;background:var(--s1);border-radius:999px;padding:5px;\n  display:grid;grid-template-columns:1fr 1fr;gap:4px;border:1px solid rgba(255,255,255,.04);\n}\n.seg{height:42px;border-radius:999px;display:flex;align-items:center;justify-content:center;gap:9px;font-size:14px;font-weight:600;color:var(--muted);}\n.seg i{font-size:15px;}\n.seg.active{background:var(--red);color:#fff;font-weight:700;box-shadow:0 4px 14px rgba(242,21,28,.3);}\n\n.hero-title{\n  font-family:'Bricolage Grotesque',sans-serif;\n  font-weight:800;font-size:50px;line-height:1.02;letter-spacing:-.028em;\n  margin:26px 0 22px;max-width:520px;\n}\n\n.search{\n  height:52px;border-radius:999px;background:var(--s1);border:1px solid var(--s2);\n  display:flex;align-items:center;gap:12px;padding:0 20px;color:var(--muted2);\n}\n.search i{font-size:16px;color:var(--muted);}\n.search span{font-size:15px;color:var(--muted2);}\n\n.chips{display:flex;gap:9px;margin-top:14px;flex-wrap:wrap;}\n.chip{\n  height:36px;border-radius:999px;background:var(--s1);border:1px solid var(--s2);\n  display:flex;align-items:center;gap:8px;padding:0 15px;\n  font-size:13px;font-weight:600;color:var(--muted);\n}\n.chip i{font-size:14px;}\n\n.tabs{display:flex;gap:8px;margin-top:20px;}\n.tab{\n  height:36px;border-radius:999px;padding:0 20px;display:flex;align-items:center;\n  font-size:13px;font-weight:700;background:var(--s1);color:var(--muted);border:1px solid var(--s2);\n}\n.tab.active{background:var(--red);border-color:var(--red);color:#fff;}\n\n.sec-head{display:flex;align-items:baseline;gap:9px;margin:34px 0 14px;}\n.sec-head h2{font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:800;letter-spacing:-.015em;}\n.sec-head em{font-style:normal;font-size:13px;color:var(--muted2);font-weight:600;}\n\n.store-row{\n  display:flex;align-items:center;gap:15px;\n  background:transparent;border-radius:16px;padding:6px 4px;\n}\n.store-logo{\n  width:66px;height:66px;flex:0 0 66px;border-radius:16px;overflow:hidden;background:var(--s2);\n  border:1px solid var(--s3);\n}\n.store-logo img{width:100%;height:100%;object-fit:cover;display:block;}\n.store-info{flex:1 1 auto;min-width:0;}\n.store-name{font-size:16.5px;font-weight:800;letter-spacing:.01em;}\n.store-meta{display:flex;align-items:center;gap:14px;margin-top:7px;font-size:12.8px;color:var(--muted2);font-weight:500;}\n.store-meta .new{\n  border:1px solid var(--s3);border-radius:999px;padding:2px 8px;\n  font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);\n}\n.badge-open{\n  display:flex;align-items:center;gap:6px;height:26px;padding:0 11px;border-radius:999px;\n  background:var(--success-soft);color:var(--success);font-size:11.5px;font-weight:700;\n}\n.badge-open span{width:5px;height:5px;border-radius:50%;background:var(--success);}\n\n.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;}\n.pcard{\n  background:var(--s1);border:1px solid var(--s2);border-radius:18px;overflow:hidden;\n}\n.pcard img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:var(--s2);}\n.pbody{padding:11px 12px 14px;}\n.pname{font-size:13.5px;font-weight:700;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n.pstore{font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted2);font-weight:700;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n.pprice{margin-top:9px;font-size:14.5px;font-weight:800;letter-spacing:-.01em;}\n\n.more{\n  margin-top:16px;height:48px;width:100%;border-radius:999px;border:1px solid var(--s3);\n  display:flex;align-items:center;justify-content:center;gap:8px;\n  font-size:13.5px;font-weight:700;color:#fff;background:transparent;\n}\n.more i{font-size:13px;color:var(--muted2);}\n</style>\n<div class=\"shell\" data-kid=\"1\">\n<aside class=\"sidebar\" data-kid=\"1-1\">\n<div class=\"brand\" data-kid=\"1-1-1\">\n<div class=\"logo\" data-kid=\"1-1-1-1\"><i class=\"bi bi-truck\" data-kid=\"1-1-1-1-1\"></i></div>\n<div class=\"brand-name\" data-kid=\"1-1-1-2\">Já Bazou</div>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-2\">\n<div class=\"nav-item active\" data-kid=\"1-1-2-1\"><i class=\"bi bi-house-door-fill\" data-kid=\"1-1-2-1-1\"></i>Início</div>\n<div class=\"nav-item\" data-kid=\"1-1-2-2\"><i class=\"bi bi-bag\" data-kid=\"1-1-2-2-1\"></i>Carrinho</div>\n<div class=\"nav-item\" data-kid=\"1-1-2-3\"><i class=\"bi bi-person\" data-kid=\"1-1-2-3-1\"></i>Entrar</div>\n</nav>\n<div class=\"help-label\" data-kid=\"1-1-3\">Ajuda</div>\n<nav class=\"nav\" data-kid=\"1-1-4\">\n<div class=\"nav-item\" data-kid=\"1-1-4-1\"><i class=\"bi bi-info-square\" data-kid=\"1-1-4-1-1\"></i>Como funciona</div>\n</nav>\n<div class=\"sidebar-foot\" data-kid=\"1-1-5\">\n<div class=\"btn btn-primary\" data-kid=\"1-1-5-1\">Entrar</div>\n<div class=\"btn btn-ghost\" data-kid=\"1-1-5-2\">Criar conta</div>\n</div>\n</aside>\n<main class=\"main\" data-kid=\"1-2\">\n<div class=\"canvas\" data-kid=\"1-2-1\">\n<div class=\"topbar\" data-kid=\"1-2-1-1\">\n<div class=\"topbar-brand\" data-kid=\"1-2-1-1-1\">\n<div class=\"logo\" data-kid=\"1-2-1-1-1-1\"><i class=\"bi bi-truck\" data-kid=\"1-2-1-1-1-1-1\"></i></div>\n<span data-kid=\"1-2-1-1-1-2\">Já Bazou</span>\n</div>\n<div class=\"top-cta\" data-kid=\"1-2-1-1-2\">Entrar</div>\n</div>\n<div class=\"segmented\" data-kid=\"1-2-1-2\">\n<div class=\"seg active\" data-kid=\"1-2-1-2-1\"><i class=\"bi bi-bicycle\" data-kid=\"1-2-1-2-1-1\"></i>Comida</div>\n<div class=\"seg\" data-kid=\"1-2-1-2-2\"><i class=\"bi bi-basket2\" data-kid=\"1-2-1-2-2-1\"></i>Mercado</div>\n</div>\n<h1 class=\"hero-title\" data-kid=\"1-2-1-3\">O que vai bazar hoje?</h1>\n<div class=\"search\" data-kid=\"1-2-1-4\">\n<i class=\"bi bi-search\" data-kid=\"1-2-1-4-1\"></i>\n<span data-kid=\"1-2-1-4-2\">Pratos, lojas, farmácias...</span>\n</div>\n<div class=\"chips\" data-kid=\"1-2-1-5\">\n<div class=\"chip\" data-kid=\"1-2-1-5-1\"><i class=\"bi bi-geo-alt\" data-kid=\"1-2-1-5-1-1\"></i>Lojas perto de mim</div>\n<div class=\"chip\" data-kid=\"1-2-1-5-2\"><i class=\"bi bi-bicycle\" data-kid=\"1-2-1-5-2-1\"></i>Entrega grátis</div>\n</div>\n<div class=\"tabs\" data-kid=\"1-2-1-6\">\n<div class=\"tab active\" data-kid=\"1-2-1-6-1\">Tudo</div>\n<div class=\"tab\" data-kid=\"1-2-1-6-2\">Restaurantes</div>\n</div>\n<div class=\"sec-head\" data-kid=\"1-2-1-7\">\n<h2 data-kid=\"1-2-1-7-1\">Todas as lojas</h2>\n<em data-kid=\"1-2-1-7-2\">1</em>\n</div>\n<div class=\"store-row\" data-kid=\"1-2-1-8\">\n<div class=\"store-logo\" data-kid=\"1-2-1-8-1\">\n<img alt=\"COMANCHERO — foto de Allan González (Pexels)\" data-kid=\"1-2-1-8-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/31650325/pexels-photo-31650325.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200&amp;q=80\"/>\n</div>\n<div class=\"store-info\" data-kid=\"1-2-1-8-2\">\n<div class=\"store-name\" data-kid=\"1-2-1-8-2-1\">COMANCHERO</div>\n<div class=\"store-meta\" data-kid=\"1-2-1-8-2-2\">\n<span class=\"new\" data-kid=\"1-2-1-8-2-2-1\">Novo</span>\n<span data-kid=\"1-2-1-8-2-2-2\">Restaurantes</span>\n<span data-kid=\"1-2-1-8-2-2-3\">60 min</span>\n<span data-kid=\"1-2-1-8-2-2-4\">Entrega 50,00 MT/km</span>\n<span data-kid=\"1-2-1-8-2-2-5\">Mín. 350,00 MT</span>\n</div>\n</div>\n<div class=\"badge-open\" data-kid=\"1-2-1-8-3\"><span data-kid=\"1-2-1-8-3-1\"></span>Aberto</div>\n</div>\n<div class=\"sec-head\" data-kid=\"1-2-1-9\">\n<h2 data-kid=\"1-2-1-9-1\">Explorar produtos</h2>\n<em data-kid=\"1-2-1-9-2\">103</em>\n</div>\n<div class=\"grid\" data-kid=\"1-2-1-10\">\n<article class=\"pcard\" data-kid=\"1-2-1-10-1\">\n<img alt=\"Refresco 2L — foto de Fafegh (Pexels)\" data-kid=\"1-2-1-10-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7001005/pexels-photo-7001005.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=600&amp;q=80\"/>\n<div class=\"pbody\" data-kid=\"1-2-1-10-1-2\">\n<div class=\"pname\" data-kid=\"1-2-1-10-1-2-1\">Refresco 2L</div>\n<div class=\"pstore\" data-kid=\"1-2-1-10-1-2-2\">COMANCHERO</div>\n<div class=\"pprice\" data-kid=\"1-2-1-10-1-2-3\">210,00 MT</div>\n</div>\n</article>\n<article class=\"pcard\" data-kid=\"1-2-1-10-2\">\n<img alt=\"Refresco 1L — foto de BlvckArt Studio (Pexels)\" data-kid=\"1-2-1-10-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/29051732/pexels-photo-29051732.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=600&amp;q=80\"/>\n<div class=\"pbody\" data-kid=\"1-2-1-10-2-2\">\n<div class=\"pname\" data-kid=\"1-2-1-10-2-2-1\">Refresco 1L</div>\n<div class=\"pstore\" data-kid=\"1-2-1-10-2-2-2\">COMANCHERO</div>\n<div class=\"pprice\" data-kid=\"1-2-1-10-2-2-3\">160,00 MT</div>\n</div>\n</article>\n<article class=\"pcard\" data-kid=\"1-2-1-10-3\">\n<img alt=\"Sumo Compal 1000ML — foto de Nahas NR (Pexels)\" data-kid=\"1-2-1-10-3-1\" decoding=\"async\" l